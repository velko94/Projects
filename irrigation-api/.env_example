# PostgreSQL database configuration
POSTGRES_DB=irrigation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
DB_HOST=irrigation-db

# API authentication key (replace with a strong secret)
IRRIGATION_API_KEY=change_me_api_key

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://0.0.0.0:8080